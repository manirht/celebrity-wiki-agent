# Example environment configuration for the Celebrity Wiki Agent
# Copy this file to `.env` and replace the placeholder values with your real keys.

# Groq API key for the Qwen model (used by the main agent)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API key (used by the remote MCP search server)
TAVILY_API_KEY=your_tavily_api_key_here

